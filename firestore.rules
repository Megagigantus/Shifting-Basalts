rules_version = '2';

// Invite-only access.
// - Everyone signs in with Google.
// - invites/{email} lists who may use the app. The document ID is the
//   lowercase email; the "role" field is "dm" or "player".
// - Signed-in accounts that aren't on the list get nothing at all.
// - Players can read shared data but never anything under dmOnly.
// - Anything not matched below is denied.
// Tested by tests/firestore.rules.test.ts (npm run test:rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function myInvitePath() {
      return /databases/$(database)/documents/invites/$(myEmail());
    }

    function isInvited() {
      return signedIn() && exists(myInvitePath());
    }

    function isDM() {
      return isInvited() && get(myInvitePath()).data.role == 'dm';
    }

    // The invite list. Only the DM manages it. Anyone signed in can check
    // their own invite, which is how the app tells "not invited" apart.
    match /invites/{inviteEmail} {
      allow read: if isDM() || (signedIn() && inviteEmail == myEmail());
      allow create, update: if isDM()
        && inviteEmail == inviteEmail.lower()
        && request.resource.data.role in ['dm', 'player'];
      // The DM can't delete their own invite and lock themselves out.
      allow delete: if isDM() && inviteEmail != myEmail();
    }

    // BEGIN GENERATED (npm run sync-rules). Do not edit by hand.
    // Upgrade id -> price of each rank (from src/data/upgrades.json).
    function upgradePrices() {
      return {
        'starting-boon': [15],
        'forge': [30],
        'healing-font': [30],
        'extra-boon-slot': [40, 120],
        'reroll': [10, 20, 35],
        'extra-loot': [15, 30, 50],
        'extra-pressures': [20, 40],
        'reprieve': [20, 35, 55, 80],
        'attunement': [15],
        'banish': [10, 20, 30],
        'hidden-sight': [20],
        'deep-pockets': [25, 50, 80],
        'quick-return': [10, 20, 30],
        'lost-and-found': [30, 75, 150],
        'reclamation-shrine': [50]
      };
    }

    // Upgrades only a character with a survived full clear may buy.
    function fullClearUpgrades() {
      return ['lost-and-found', 'reclamation-shrine'];
    }

    // Most Devotions one track may hold at a character level (tier caps).
    function devotionCap(level) {
      return level < 5 ? 0 : level <= 10 ? 15 : level <= 16 ? 40 : level <= 20 ? 120 : 0;
    }

    // Every boon id (from src/data/boons.json), for checking Banish lists.
    function boonIds() {
      return ['traverts-echoes', 'reapers-sprint', 'spellslingers-delight', 'critical-delight', 'crits-are-for-suckers', 'a-fine-steels-glint', 'stand-off', 'elemains-flight-of-fancy', 'overhealing', 'hardened-hide', 'cleansing-nova', 'riposte-step', 'a-healthy-dose-of-pain', 'avalanche-stride', 'spillover', 'overchannel', 'conduit', 'unbroken-focus', 'elemental-residue', 'leyline-surge', 'momentum', 'deadeye-stance', 'scatter-volley', 'fading-veil', 'first-strike', 'vanishing-step', 'twin-flame', 'bolster', 'kindled-ally', 'ostras-coin', 'lenns-descent', 'corrows-lure', 'collectors-menagerie', 'thalisanes-weave', 'the-express', 'breakers-last-stand', 'thilss-favor', 'zolics-nine-eyes', 'deflector-burst', 'hunters-tally', 'gleam-dealers-gamble', 'fleet-foot', 'unshackled', 'elemental-ward', 'pocket-sweep', 'quick-cantrip', 'hardy', 'honed', 'keen-reflexes', 'steady-will', 'night-eyes', 'resounding-blow', 'echoing-step', 'last-rites', 'harvest', 'marked-quarry', 'weak-point', 'thousand-cuts', 'second-hand', 'bleed-out', 'red-mist', 'lucky-break', 'iron-root', 'pack-tactics', 'swap-places', 'elemental-quiver', 'battle-standard', 'ulmas-thread', 'the-archivists-index', 'weavers-mending'];
    }

    // Every boon tag, for checking Attunement choices.
    function boonTags() {
      return ['Echo', 'Reaper', 'Spell', 'Crit', 'Stance', 'Volley', 'Guard', 'Payoff', 'Shadow', 'Rally', 'Bond', 'Flurry', 'Blood', 'Hunt', 'Core'];
    }

    // True if this update is a valid Devotion spend on one of the tracks.
    function anyTrackSpend() {
      return devotionSpendOn('max-hp')
        || devotionSpendOn('spell-slot-recovery')
        || devotionSpendOn('martial-resource-recovery')
        || devotionSpendOn('opening-temp-hp')
        || devotionSpendOn('flat-damage')
        || devotionSpendOn('healing-received')
        || devotionSpendOn('speed')
        || devotionSpendOn('fortune-dice');
    }

    // True if this update is a valid purchase of one of the upgrades. Only the
    // upgrade that changed is checked in full, to stay under the rules' work limit.
    function anyUpgradePurchase(changed) {
      return (changed.hasOnly(['starting-boon']) && upgradePurchaseOf('starting-boon'))
        || (changed.hasOnly(['forge']) && upgradePurchaseOf('forge'))
        || (changed.hasOnly(['healing-font']) && upgradePurchaseOf('healing-font'))
        || (changed.hasOnly(['extra-boon-slot']) && upgradePurchaseOf('extra-boon-slot'))
        || (changed.hasOnly(['reroll']) && upgradePurchaseOf('reroll'))
        || (changed.hasOnly(['extra-loot']) && upgradePurchaseOf('extra-loot'))
        || (changed.hasOnly(['extra-pressures']) && upgradePurchaseOf('extra-pressures'))
        || (changed.hasOnly(['reprieve']) && upgradePurchaseOf('reprieve'))
        || (changed.hasOnly(['attunement']) && upgradePurchaseOf('attunement'))
        || (changed.hasOnly(['banish']) && upgradePurchaseOf('banish'))
        || (changed.hasOnly(['hidden-sight']) && upgradePurchaseOf('hidden-sight'))
        || (changed.hasOnly(['deep-pockets']) && upgradePurchaseOf('deep-pockets'))
        || (changed.hasOnly(['quick-return']) && upgradePurchaseOf('quick-return'))
        || (changed.hasOnly(['lost-and-found']) && upgradePurchaseOf('lost-and-found'))
        || (changed.hasOnly(['reclamation-shrine']) && upgradePurchaseOf('reclamation-shrine'));
    }
    // END GENERATED

    // Fields changed by this update.
    function changedFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // True if the signed-in player owns this character and it's in this active run.
    function ownsRunCharacter(runId, characterId) {
      let run = get(/databases/$(database)/documents/runs/$(runId)).data;
      let character = get(/databases/$(database)/documents/characters/$(characterId)).data;
      return isInvited()
        && character.get('playerEmail', '') == myEmail()
        && run.status == 'active'
        && characterId in run.characterIds;
    }

    // The player who owns this character (by the email the DM assigned).
    function ownsCharacter() {
      return isInvited() && resource.data.get('playerEmail', '') == myEmail();
    }

    // A player invests banked Devotions in exactly one stat track: only
    // upward, the bank drops by exactly that much, and the track stays within
    // the tier cap for the character's level. Refunds are DM-only. Only
    // between runs: the Basalt Shrine is closed while the character is inside.
    function isDevotionSpend() {
      return changedFields().hasOnly(['trackDevotions', 'bankedDevotions', 'updatedAt'])
        && changedFields().hasAll(['trackDevotions', 'bankedDevotions'])
        && request.resource.data.updatedAt == request.time
        && notInRun()
        && anyTrackSpend();
    }

    // The spend checks for one named track (anyTrackSpend tries each track id).
    function devotionSpendOn(track) {
      let before = resource.data.get('trackDevotions', {});
      let after = request.resource.data.trackDevotions;
      let added = after.get(track, 0) - before.get(track, 0);
      return after.diff(before).affectedKeys().hasOnly([track])
        && after[track] is int
        && added > 0
        && request.resource.data.bankedDevotions == resource.data.get('bankedDevotions', 0) - added
        && request.resource.data.bankedDevotions >= 0
        && after[track] <= devotionCap(resource.data.level);
    }

    // A player buys the next rank of exactly one upgrade, paying exactly its
    // price from banked Quantum Basalts. Refunds are DM-only. Only between
    // runs: the Basalt Markets are closed while the character is inside.
    function isUpgradePurchase() {
      return changedFields().hasOnly(['upgrades', 'bankedQuantumBasalts', 'updatedAt'])
        && changedFields().hasAll(['upgrades', 'bankedQuantumBasalts'])
        && request.resource.data.updatedAt == request.time
        && notInRun()
        && anyUpgradePurchase(request.resource.data.upgrades.diff(resource.data.get('upgrades', {})).affectedKeys());
    }

    // The purchase checks for one named upgrade (anyUpgradePurchase tries each id).
    // Full-clear rewards also need a survived full clear (fullClears, set by the DM's app).
    function upgradePurchaseOf(upgrade) {
      let before = resource.data.get('upgrades', {});
      let after = request.resource.data.upgrades;
      let owned = before.get(upgrade, 0);
      let prices = upgradePrices()[upgrade];
      return after.diff(before).affectedKeys().hasOnly([upgrade])
        && owned < prices.size()
        && after.get(upgrade, 0) == owned + 1
        && (!(upgrade in fullClearUpgrades()) || resource.data.get('fullClears', 0) >= 1)
        && request.resource.data.bankedQuantumBasalts
          == resource.data.get('bankedQuantumBasalts', 0) - prices[owned]
        && request.resource.data.bankedQuantumBasalts >= 0;
    }

    // A character in an active run carries activeRunId; Banish and Attunement
    // can only be edited between runs (Build clarifications: Banish).
    function notInRun() {
      return resource.data.get('activeRunId', null) == null;
    }

    // A player edits their Banish list: real boon ids, no repeats, no longer
    // than their Banish rank, and only boons they banished from a draft before
    // (their banish history) or already on the list.
    function isBanishEdit() {
      let list = request.resource.data.banished;
      return changedFields().hasOnly(['banished', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && notInRun()
        && list is list
        && list.size() <= resource.data.get('upgrades', {}).get('banish', 0)
        && list.toSet().size() == list.size()
        && list.hasOnly(boonIds())
        && list.hasOnly(resource.data.get('banishHistory', []).concat(resource.data.get('banished', [])));
    }

    // A player sets (or clears) their Attunement tag, if they own Attunement.
    function isAttunementEdit() {
      let tag = request.resource.data.attuneTag;
      return changedFields().hasOnly(['attuneTag', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && notInRun()
        && resource.data.get('upgrades', {}).get('attunement', 0) >= 1
        && (tag == null || tag in boonTags());
    }

    // Shared build field checks for both character creation and build edits.
    function validBuild(d) {
      let second = d.get('secondClassId', '');
      return d.classId is string && d.classId.size() <= 40
        && d.get('subclass', '') is string && d.get('subclass', '').size() <= 60
        && second is string && second.size() <= 40
        && d.get('secondSubclass', '') is string && d.get('secondSubclass', '').size() <= 60
        && d.classLevel is int && d.classLevel >= 1
        && d.get('secondClassLevel', 0) is int && d.get('secondClassLevel', 0) >= 0
        && d.level is int && d.level >= 1 && d.level <= 20
        && d.level == d.classLevel + (second == '' ? 0 : d.get('secondClassLevel', 0))
        && d.get('classOrders', {}) is map && d.get('classOrders', {}).size() <= 4
        && d.get('extraWeapons', []) is list && d.get('extraWeapons', []).size() <= 30
        && d.get('extraArmor', []) is list && d.get('extraArmor', []).size() <= 4
        && d.get('masteries', []) is list && d.get('masteries', []).size() <= 6
        && d.get('homebrewTags', {}) is map;
    }

    // A player saves their character's build (Character setup) between runs:
    // classes and levels, subclasses, orders, extra training, mastery picks and
    // homebrew tags. Level must be the total of both classes. The DM reviews
    // builds at run setup.
    function isBuildEdit() {
      let d = request.resource.data;
      return changedFields().hasOnly(['classId', 'subclass', 'classLevel', 'secondClassId', 'secondClassLevel', 'secondSubclass',
          'classOrders', 'extraWeapons', 'extraArmor', 'masteries', 'homebrewTags', 'level', 'updatedAt'])
        && d.updatedAt == request.time
        && notInRun()
        && validBuild(d);
    }

    // A player picks their character's portrait and summon art, any time:
    // short file names (lowercase letters, digits and dashes) or "" for none.
    function isLookEdit() {
      return changedFields().hasOnly(['portrait', 'summonArt', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.get('portrait', '') is string
        && request.resource.data.get('portrait', '').matches('[a-z0-9-]{0,40}')
        && request.resource.data.get('summonArt', '') is string
        && request.resource.data.get('summonArt', '').matches('[a-z0-9-]{0,40}');
    }

    // An invited player creates a new character for themselves, starting with
    // a valid profile, empty favoredTags, and an empty dungeon layer.
    function isNewOwnCharacter() {
      let d = request.resource.data;
      return isInvited()
        && d.keys().hasOnly([
          'name', 'playerEmail', 'classId', 'subclass', 'level', 'classLevel',
          'secondClassId', 'secondClassLevel', 'secondSubclass', 'classOrders',
          'extraWeapons', 'extraArmor', 'masteries', 'homebrewTags', 'casterType',
          'hasSummon', 'attackStyle', 'favoredTags', 'portrait', 'summonArt',
          'bankedQuantumBasalts', 'bankedDevotions', 'trackDevotions', 'deepestFloor',
          'fullClears', 'lockoutDays', 'upgrades', 'banished', 'banishHistory',
          'attuneTag', 'activeRunId', 'loot', 'echoes',
          'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll([
          'bankedQuantumBasalts', 'bankedDevotions', 'trackDevotions', 'deepestFloor',
          'fullClears', 'lockoutDays', 'upgrades', 'banished', 'banishHistory',
          'attuneTag', 'activeRunId', 'loot', 'echoes',
          'name', 'playerEmail', 'classId', 'level', 'classLevel', 'createdAt', 'updatedAt'
        ])
        && d.playerEmail == myEmail()
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && d.bankedQuantumBasalts == 0
        && d.bankedDevotions == 0
        && d.trackDevotions == {}
        && d.deepestFloor == 0
        && d.fullClears == 0
        && d.lockoutDays == 0
        && d.upgrades == {}
        && d.banished == []
        && d.banishHistory == []
        && d.attuneTag == null
        && d.activeRunId == null
        && d.loot == []
        && d.echoes == {'boons': [], 'evolutions': [], 'combinations': [], 'hidden': []}
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && validBuild(d)
        && d.casterType in ['none', 'half', 'full', 'pact']
        && d.attackStyle in ['melee', 'ranged', 'spells']
        && d.hasSummon is bool
        && d.favoredTags == []
        && d.get('portrait', '') is string
        && d.get('portrait', '').matches('[a-z0-9-]{0,40}')
        && d.get('summonArt', '') is string
        && d.get('summonArt', '').matches('[a-z0-9-]{0,40}');
    }

    // Saved characters. The DM can change or delete anything; an invited player
    // can create their own character with an empty dungeon layer, and the owning
    // player can only spend their own Devotions and Quantum Basalts, edit their
    // Banish list, Attunement tag and build between runs, and pick their
    // portrait and summon art, as checked above.
    match /characters/{characterId} {
      allow read: if isInvited();
      allow create: if isDM() || isNewOwnCharacter();
      allow update: if isDM()
        || (ownsCharacter()
          && (isDevotionSpend() || isUpgradePurchase() || isBanishEdit() || isAttunementEdit() || isLookEdit() || isBuildEdit()));
      allow delete: if isDM();
    }

    // A player's Pressure wishes for their character's next run. Everyone
    // invited can see them; only that character's player writes them, as a
    // short list of ids. The DM chooses the Pressures with the wishes in view.
    match /pressureWishes/{characterId} {
      allow read: if isInvited();
      allow write: if isDM();
      allow create, update: if isInvited()
        && get(/databases/$(database)/documents/characters/$(characterId)).data.get('playerEmail', '') == myEmail()
        && request.resource.data.keys().hasOnly(['pressures', 'updatedAt'])
        && request.resource.data.pressures is list
        && request.resource.data.pressures.size() <= 20
        && request.resource.data.updatedAt == request.time;
      allow delete: if isInvited()
        && get(/databases/$(database)/documents/characters/$(characterId)).data.get('playerEmail', '') == myEmail();
    }

    match /runs/{runId} {
      allow read: if isInvited();
      allow write: if isDM();

      // Each player's state within a run.
      match /players/{characterId} {
        allow read: if isInvited();
        allow write: if isDM();
      }

      // A player's pending draft choice, which the DM's app applies with the
      // draft rules. A player may only write their own character's choice,
      // in an active run that character is in, with only the choice fields.
      match /choices/{characterId} {
        allow read: if isInvited();
        allow write: if isDM();
        allow create, update: if ownsRunCharacter(runId, characterId)
          && request.resource.data.keys().hasOnly(['action', 'index', 'replaceSlot', 'hiddenBoonId', 'forgeKind', 'slotIndex', 'combinationId', 'relicId', 'recoveryTrack', 'presetId', 'boonId', 'trinketUid', 'targetUid', 'draftKey', 'createdAt'])
          && request.resource.data.action in ['take', 'pass', 'reroll', 'banish', 'hidden', 'passHidden', 'forge', 'hiddenSight', 'relic', 'relicPass', 'recover', 'payoffSpend', 'payoffRefund', 'fortuneUse', 'reprieveRest', 'reprieveReflect', 'reprieveBasalts', 'shrineOffering', 'wakeRelic']
          && request.resource.data.createdAt == request.time;
        allow delete: if ownsRunCharacter(runId, characterId);
      }

      // A player's descend-or-extract vote after a boss. Everyone in the app
      // can see votes; only that character's player casts one, as a single
      // choice for one floor. The DM decides with the votes in view.
      match /votes/{characterId} {
        allow read: if isInvited();
        allow write: if isDM();
        allow create, update: if ownsRunCharacter(runId, characterId)
          && request.resource.data.keys().hasOnly(['vote', 'floor', 'updatedAt'])
          && request.resource.data.vote in ['descend', 'extract']
          && request.resource.data.floor is int
          && request.resource.data.updatedAt == request.time;
        allow delete: if ownsRunCharacter(runId, characterId);
      }

      // A player's Reclamation Shrine pledge: Basalts toward bringing back one
      // fallen ally. Everyone in the app can see pledges; only that character's
      // player writes one. The DM's app checks each pledge against what the
      // player actually earned and takes the Basalts when the DM reclaims.
      match /pledges/{characterId} {
        allow read: if isInvited();
        allow write: if isDM();
        allow create, update: if ownsRunCharacter(runId, characterId)
          && request.resource.data.keys().hasOnly(['targetId', 'amount', 'floor', 'updatedAt'])
          && request.resource.data.targetId is string && request.resource.data.targetId.size() <= 64
          && request.resource.data.amount is int && request.resource.data.amount >= 0 && request.resource.data.amount <= 100000
          && request.resource.data.floor is int
          && request.resource.data.updatedAt == request.time;
        allow delete: if ownsRunCharacter(runId, characterId);
      }

      // A player's wish list from the party's loot, plus a Done flag once they
      // finish picking. Everyone in the app can see requests; only that
      // character's player writes them, as a short list of item ids. The DM
      // decides who gets what at extraction.
      match /requests/{characterId} {
        allow read: if isInvited();
        allow write: if isDM();
        allow create, update: if ownsRunCharacter(runId, characterId)
          && request.resource.data.keys().hasOnly(['uids', 'done', 'updatedAt'])
          && request.resource.data.uids is list
          && request.resource.data.uids.size() <= 100
          && request.resource.data.get('done', false) is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if ownsRunCharacter(runId, characterId);
      }

      // A player's token on the battle map, and their summon's (sx, sy) if
      // they have one. Everyone invited can see where tokens are; only that
      // character's player (or the DM) moves them, as squares on the grid
      // (at most 14 x 14) plus the room they're in.
      function onGrid(v) {
        return v is int && v >= 0 && v < 14;
      }
      match /tokens/{characterId} {
        allow read: if isInvited();
        allow write: if isDM();
        allow create, update: if ownsRunCharacter(runId, characterId)
          && request.resource.data.keys().hasOnly(['x', 'y', 'sx', 'sy', 'roomKey', 'updatedAt'])
          && onGrid(request.resource.data.x)
          && onGrid(request.resource.data.y)
          && onGrid(request.resource.data.get('sx', 0))
          && onGrid(request.resource.data.get('sy', 0))
          && request.resource.data.roomKey is string && request.resource.data.roomKey.size() <= 20
          && request.resource.data.updatedAt == request.time;
        allow delete: if ownsRunCharacter(runId, characterId);
      }

      // A player's private Hidden Sight hints: only that player and the DM can read them.
      match /private/{characterId} {
        allow read: if isDM() || ownsRunCharacter(runId, characterId);
        allow write: if isDM();
      }

      // Moments: cinematic reveals the DM triggers and every screen plays
      // (presentation only; game state lives elsewhere). Everyone invited can
      // read them; only the DM creates one, as "playing", and afterwards may
      // change only its status (skip or done) or delete it.
      match /moments/{momentId} {
        allow read: if isInvited();
        allow create: if isDM()
          && request.resource.data.keys().hasOnly(['type', 'payload', 'audience', 'createdAt', 'createdBy', 'status'])
          && request.resource.data.type is string && request.resource.data.type.size() <= 40
          && request.resource.data.payload is map
          && request.resource.data.audience is map
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'playing';
        allow update: if isDM()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['playing', 'skipped', 'done'];
        allow delete: if isDM();
      }

      // Hidden information: enemy stats, hidden condition, unsprung tricks.
      // DM only, always.
      match /dmOnly/{docId} {
        allow read, write: if isDM();
      }

      // Queued Lore Moments for this run. DM only, always.
      match /loreQueue/{queueId} {
        allow read, write: if isDM();
      }

      // A character's revealed Lore Moment in this run. Only the owning player
      // in this active run and the DM can read it; only the DM writes it.
      match /loreReveal/{characterId} {
        allow read: if isDM() || ownsRunCharacter(runId, characterId);
        allow write: if isDM();
      }
    }

    match /runHistory/{runId} {
      allow read: if isInvited();
      allow write: if isDM();
    }

    // Lore Moment cards hold campaign secrets ("DM truth"). DM only, always.
    match /loreCards/{cardId} {
      allow read, write: if isDM();
    }

    // Lore card groups and order settings. DM only, always.
    match /loreGroups/{groupId} {
      allow read, write: if isDM();
    }

    // Lore deck state and pacing settings. DM only, always.
    match /loreState/{docId} {
      allow read, write: if isDM();
    }

    // The party's questions to their Stride Anchor and the DM's answers. DM only, always.
    match /loreDispatches/{dispatchId} {
      allow read, write: if isDM();
    }

    // Lore summary with only group names and card counts, for the players'
    // Library "???" placeholders. Everyone invited can read; only the DM writes.
    match /loreSummary/{docId} {
      allow read: if isInvited();
      allow write: if isDM();
    }

    // A player's Lore archive notes, keyed by lowercase email. Only that
    // invited player and the DM can read them; only the DM writes them.
    match /loreNotes/{email}/notes/{revealId} {
      allow read: if isDM() || (isInvited() && email == myEmail());
      allow write: if isDM();
    }
  }
}
