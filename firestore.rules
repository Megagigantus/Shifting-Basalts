rules_version = '2';

// Invite-only access.
// - Everyone signs in with Google.
// - invites/{email} lists who may use the app. The document ID is the
//   lowercase email; the "role" field is "dm" or "player".
// - Signed-in accounts that aren't on the list get nothing at all.
// - Players can read shared data but never anything under dmOnly.
// - Anything not matched below is denied.
// Tested by tests/firestore.rules.test.ts (npm run test:rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function myInvitePath() {
      return /databases/$(database)/documents/invites/$(myEmail());
    }

    function isInvited() {
      return signedIn() && exists(myInvitePath());
    }

    function isDM() {
      return isInvited() && get(myInvitePath()).data.role == 'dm';
    }

    // The invite list. Only the DM manages it. Anyone signed in can check
    // their own invite, which is how the app tells "not invited" apart.
    match /invites/{inviteEmail} {
      allow read: if isDM() || (signedIn() && inviteEmail == myEmail());
      allow create, update: if isDM()
        && inviteEmail == inviteEmail.lower()
        && request.resource.data.role in ['dm', 'player'];
      // The DM can't delete their own invite and lock themselves out.
      allow delete: if isDM() && inviteEmail != myEmail();
    }

    // BEGIN GENERATED (npm run sync-rules). Do not edit by hand.
    // Upgrade id -> price of each rank (from src/data/upgrades.json).
    function upgradePrices() {
      return {
        'starting-boon': [15],
        'forge': [30],
        'healing-font': [30],
        'extra-boon-slot': [40, 120],
        'reroll': [10, 20, 35],
        'extra-loot': [15, 30, 50],
        'extra-pressures': [20, 40],
        'reprieve': [20, 35, 55, 80],
        'attunement': [15],
        'banish': [10, 20, 30],
        'hidden-sight': [20],
        'deep-pockets': [25, 50, 80],
        'quick-return': [10, 20, 30]
      };
    }

    // Stat track ids (from src/data/stat-tracks.json).
    function statTrackIds() {
      return ['max-hp', 'spell-slot-recovery', 'opening-temp-hp', 'flat-damage', 'healing-received', 'speed', 'fortune-dice'];
    }

    // Most Devotions one track may hold at a character level (tier caps).
    function devotionCap(level) {
      return level < 5 ? 0 : level <= 10 ? 15 : level <= 16 ? 40 : level <= 20 ? 120 : 0;
    }

    // Every boon id (from src/data/boons.json), for checking Banish lists.
    function boonIds() {
      return ['traverts-echoes', 'reapers-sprint', 'spellslingers-delight', 'critical-delight', 'crits-are-for-suckers', 'a-fine-steels-glint', 'stand-off', 'elemains-flight-of-fancy', 'overhealing', 'hardened-hide', 'cleansing-nova', 'riposte-step', 'a-healthy-dose-of-pain', 'avalanche-stride', 'spillover', 'overchannel', 'conduit', 'unbroken-focus', 'elemental-residue', 'leyline-surge', 'deadeye-stance', 'scatter-volley', 'fading-veil', 'first-strike', 'vanishing-step', 'twin-flame', 'bolster', 'kindled-ally', 'ostras-coin', 'lenns-descent', 'corrows-lure', 'collectors-menagerie', 'thalisanes-weave', 'the-express', 'breakers-last-stand', 'thilss-favor', 'zolics-nine-eyes', 'deflector-burst', 'hunters-tally', 'gleam-dealers-gamble', 'fleet-foot', 'unshackled', 'elemental-ward', 'pocket-sweep', 'quick-cantrip', 'hardy', 'honed', 'keen-reflexes', 'steady-will', 'night-eyes', 'resounding-blow', 'echoing-step', 'last-rites', 'harvest', 'marked-quarry', 'weak-point', 'thousand-cuts', 'second-hand', 'bleed-out', 'red-mist', 'lucky-break', 'iron-root', 'pack-tactics', 'swap-places', 'elemental-quiver', 'battle-standard', 'ulmas-thread', 'the-archivists-index', 'weavers-mending'];
    }

    // Every boon tag, for checking Attunement choices.
    function boonTags() {
      return ['Echo', 'Reaper', 'Spell', 'Crit', 'Stance', 'Volley', 'Guard', 'Payoff', 'Shadow', 'Rally', 'Bond', 'Flurry', 'Blood', 'Hunt', 'Core'];
    }

    // True if this update is a valid Devotion spend on one of the tracks.
    function anyTrackSpend() {
      return devotionSpendOn('max-hp')
        || devotionSpendOn('spell-slot-recovery')
        || devotionSpendOn('opening-temp-hp')
        || devotionSpendOn('flat-damage')
        || devotionSpendOn('healing-received')
        || devotionSpendOn('speed')
        || devotionSpendOn('fortune-dice');
    }

    // True if this update is a valid purchase of one of the upgrades.
    function anyUpgradePurchase() {
      return upgradePurchaseOf('starting-boon')
        || upgradePurchaseOf('forge')
        || upgradePurchaseOf('healing-font')
        || upgradePurchaseOf('extra-boon-slot')
        || upgradePurchaseOf('reroll')
        || upgradePurchaseOf('extra-loot')
        || upgradePurchaseOf('extra-pressures')
        || upgradePurchaseOf('reprieve')
        || upgradePurchaseOf('attunement')
        || upgradePurchaseOf('banish')
        || upgradePurchaseOf('hidden-sight')
        || upgradePurchaseOf('deep-pockets')
        || upgradePurchaseOf('quick-return');
    }
    // END GENERATED

    // Fields changed by this update.
    function changedFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // True if the signed-in player owns this character and it's in this active run.
    function ownsRunCharacter(runId, characterId) {
      let run = get(/databases/$(database)/documents/runs/$(runId)).data;
      let character = get(/databases/$(database)/documents/characters/$(characterId)).data;
      return isInvited()
        && character.get('playerEmail', '') == myEmail()
        && run.status == 'active'
        && characterId in run.characterIds;
    }

    // The player who owns this character (by the email the DM assigned).
    function ownsCharacter() {
      return isInvited() && resource.data.get('playerEmail', '') == myEmail();
    }

    // A player invests banked Devotions in exactly one stat track: only
    // upward, the bank drops by exactly that much, and the track stays within
    // the tier cap for the character's level. Refunds are DM-only.
    function isDevotionSpend() {
      return changedFields().hasOnly(['trackDevotions', 'bankedDevotions', 'updatedAt'])
        && changedFields().hasAll(['trackDevotions', 'bankedDevotions'])
        && request.resource.data.updatedAt == request.time
        && anyTrackSpend();
    }

    // The spend checks for one named track (anyTrackSpend tries each track id).
    function devotionSpendOn(track) {
      let before = resource.data.get('trackDevotions', {});
      let after = request.resource.data.trackDevotions;
      let added = after.get(track, 0) - before.get(track, 0);
      return after.diff(before).affectedKeys().hasOnly([track])
        && after[track] is int
        && added > 0
        && request.resource.data.bankedDevotions == resource.data.get('bankedDevotions', 0) - added
        && request.resource.data.bankedDevotions >= 0
        && after[track] <= devotionCap(resource.data.level);
    }

    // A player buys the next rank of exactly one upgrade, paying exactly its
    // price from banked Quantum Basalts. Refunds are DM-only.
    function isUpgradePurchase() {
      return changedFields().hasOnly(['upgrades', 'bankedQuantumBasalts', 'updatedAt'])
        && changedFields().hasAll(['upgrades', 'bankedQuantumBasalts'])
        && request.resource.data.updatedAt == request.time
        && anyUpgradePurchase();
    }

    // The purchase checks for one named upgrade (anyUpgradePurchase tries each id).
    function upgradePurchaseOf(upgrade) {
      let before = resource.data.get('upgrades', {});
      let after = request.resource.data.upgrades;
      let owned = before.get(upgrade, 0);
      let prices = upgradePrices()[upgrade];
      return after.diff(before).affectedKeys().hasOnly([upgrade])
        && owned < prices.size()
        && after.get(upgrade, 0) == owned + 1
        && request.resource.data.bankedQuantumBasalts
          == resource.data.get('bankedQuantumBasalts', 0) - prices[owned]
        && request.resource.data.bankedQuantumBasalts >= 0;
    }

    // A character in an active run carries activeRunId; Banish and Attunement
    // can only be edited between runs (Build clarifications: Banish).
    function notInRun() {
      return resource.data.get('activeRunId', null) == null;
    }

    // A player edits their Banish list: real boon ids, no repeats, and no
    // longer than their Banish rank.
    function isBanishEdit() {
      let list = request.resource.data.banished;
      return changedFields().hasOnly(['banished', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && notInRun()
        && list is list
        && list.size() <= resource.data.get('upgrades', {}).get('banish', 0)
        && list.toSet().size() == list.size()
        && list.hasOnly(boonIds());
    }

    // A player sets (or clears) their Attunement tag, if they own Attunement.
    function isAttunementEdit() {
      let tag = request.resource.data.attuneTag;
      return changedFields().hasOnly(['attuneTag', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && notInRun()
        && resource.data.get('upgrades', {}).get('attunement', 0) >= 1
        && (tag == null || tag in boonTags());
    }

    // Saved characters. The DM can change anything; the owning player can
    // only spend their own Devotions and Quantum Basalts, and edit their
    // Banish list and Attunement tag between runs, as checked above.
    match /characters/{characterId} {
      allow read: if isInvited();
      allow create, delete: if isDM();
      allow update: if isDM()
        || (ownsCharacter()
          && (isDevotionSpend() || isUpgradePurchase() || isBanishEdit() || isAttunementEdit()));
    }

    match /runs/{runId} {
      allow read: if isInvited();
      allow write: if isDM();

      // Each player's state within a run.
      match /players/{characterId} {
        allow read: if isInvited();
        allow write: if isDM();
      }

      // A player's pending draft choice, which the DM's app applies with the
      // draft rules. A player may only write their own character's choice,
      // in an active run that character is in, with only the choice fields.
      match /choices/{characterId} {
        allow read: if isInvited();
        allow write: if isDM();
        allow create, update: if ownsRunCharacter(runId, characterId)
          && request.resource.data.keys().hasOnly(['action', 'index', 'replaceSlot', 'hiddenBoonId', 'draftKey', 'createdAt'])
          && request.resource.data.action in ['take', 'pass', 'reroll', 'hidden', 'passHidden']
          && request.resource.data.createdAt == request.time;
        allow delete: if ownsRunCharacter(runId, characterId);
      }

      // Hidden information: enemy stats, hidden condition, unsprung tricks.
      // DM only, always.
      match /dmOnly/{docId} {
        allow read, write: if isDM();
      }
    }

    match /runHistory/{runId} {
      allow read: if isInvited();
      allow write: if isDM();
    }
  }
}
