# Settings for local test mode (npm run dev:local). Safe to commit: these are
# made-up values that only work with the Firebase emulators on this computer.
# Vite uses this file instead of .env.local when started with --mode emulators.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-shifting-basalts.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-shifting-basalts
VITE_FIREBASE_STORAGE_BUCKET=demo-shifting-basalts.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
