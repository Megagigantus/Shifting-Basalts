{
  "version": "2024-mm",
  "rules": {
    "creatureHpWhenPushed": "round(crBenchmarks[newCr].hp * creature.hpMult)",
    "creatureSavesWhenPushed": "each save += crBenchmarks[newCr].pb - crBenchmarks[baseCr].pb; abilities and AC unchanged",
    "creaturePartySize": "room creatures never take the boss party-size HP multiplier",
    "bossTargetCr": "max(1, partyLevel + bossFloors[floor].crOffset)",
    "bossHp": "round(crBenchmarks[cr].hp * template HP mult * livingPlayers / 4)",
    "bossAbilityMod": "bossAbilityBands[band containing cr][abilityRanks[ability]]",
    "bossAbilityScore": "10 + 2 * mod",
    "bossSave": "mod + (proficientSaves includes ability ? crBenchmarks[cr].pb : 0)",
    "bossExtraLegendaryActions": "+1 if livingPlayers >= 6; +1 with Heavy Crown",
    "legendaryActionsRefresh": "boss regains spent Legendary Actions at the start of its turn"
  },
