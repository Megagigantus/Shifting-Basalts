{
  "name": "shifting-basalts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "firebase emulators:exec --only auth,firestore --project demo-shifting-basalts \"node scripts/seed-emulator.ts && vite --mode emulators --port 5174 --strictPort\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check-data": "node scripts/check-data.ts",
    "sync-rules": "node scripts/sync-rules.ts",
    "test": "vitest run src",
    "test:rules": "firebase emulators:exec --only firestore --project demo-shifting-basalts \"vitest run tests\""
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.35.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
